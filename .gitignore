# Logs and temporary files
logs/*
!logs/.gitkeep
tmp/
temp/
*.log

# Streamlit local credentials
.streamlit/secrets.toml
.streamlit/credentials.toml

# Frontend dependencies and local build output
node_modules/
frontend/node_modules/
frontend/dist/

