# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Python environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
share/python-wheels/

# Test, coverage, and quality-tool output
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

