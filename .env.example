# ============================================================
# Book RAG Assistant
# Example environment configuration
# ============================================================

APP_NAME="Book RAG Assistant"
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# Authentication
# Generate a secure value locally with:
# openssl rand -hex 32
# ------------------------------------------------------------

SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# PostgreSQL
# Replace username/password/database as required.
# ------------------------------------------------------------

POSTGRES_URL=postgresql+psycopg://postgres:your_password@localhost:5432/book_rag

# ------------------------------------------------------------
# Ollama
# ------------------------------------------------------------

OLLAMA_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------
# Retrieval / reranking
# Keep disabled until the production container wiring is enabled.
# ------------------------------------------------------------

RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

CHROMA_DB_PATH=data/chroma
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads